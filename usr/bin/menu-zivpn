#!/usr/bin/env bash
while true; do
  clear
  echo "============================================"
  echo "        HAMADA NET ZIVPN UDP MENU"
  echo "============================================"
  echo "[1] Create ZIVPN Account"
  echo "[2] Trial ZIVPN Account"
  echo "[3] Renew ZIVPN Account"
  echo "[4] Delete ZIVPN Account"
  echo "[5] Check Active Logins"
  echo "[6] Show ZIVPN Accounts"
  echo "[0] Back"
  echo "============================================"
  read -rp "Select Menu : " opt
  case "$opt" in
    1) add-zivpn ;;
    2) trial-zivpn ;;
    3) renew-zivpn ;;
    4) del-zivpn ;;
    5) cek-zivpn ;;
    6) show-zivpn ;;
    0) exit 0 ;;
    *) echo "Invalid option"; sleep 1 ;;
  esac
done
