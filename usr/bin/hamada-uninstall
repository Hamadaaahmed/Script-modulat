#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="2.0"
MODE="${1:-}"
ASSUME_YES=0
PROJECT_ROOT="${HAMADA_PROJECT_ROOT:-/root/commercial-vps-autoscript}"
BACKUP_DIR="/root/hamada-uninstall-backup-$(date +%Y%m%d-%H%M%S)"

[ "${2:-}" = "--yes" ] && ASSUME_YES=1

if [ "$(id -u)" -ne 0 ]; then
  printf 'ERROR: run as root.\n' >&2
  exit 1
fi

case "$MODE" in
  --dry-run|--reinstall|--full) ;;
  *)
    cat <<'USAGE'
HAMADA NET Uninstall Tool

Usage:
  hamada-uninstall --dry-run
  hamada-uninstall --reinstall
  hamada-uninstall --reinstall --yes
  hamada-uninstall --full
  hamada-uninstall --full --yes

Modes:
  --dry-run    Preview only. Nothing is changed.
  --reinstall  Clean previous HAMADA NET installation while preserving
               OpenSSH, current repository and the current SSH session.
  --full       Remove HAMADA NET services, data and installed commands.
USAGE
    exit 2
    ;;
esac

DRY_RUN=0
[ "$MODE" = "--dry-run" ] && DRY_RUN=1

line() {
  printf '%s\n' '============================================================'
}

section() {
  printf '\n'
  line
  printf '%s\n' "$1"
  line
}

log() {
  printf '%s\n' "$*"
}

do_cmd() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[DRY-RUN] '
    printf '%q ' "$@"
    printf '\n'
  else
    "$@"
  fi
}

service_exists() {
  systemctl cat "$1" >/dev/null 2>&1
}

stop_disable_service() {
  local svc="$1"

  if ! service_exists "$svc"; then
    [ "$DRY_RUN" -eq 1 ] && printf '[MISSING] service %s\n' "$svc"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[WOULD STOP/DISABLE] %s\n' "$svc"
    return 0
  fi

  systemctl stop "$svc" >/dev/null 2>&1 || true
  systemctl disable "$svc" >/dev/null 2>&1 || true
}

remove_path() {
  local path="$1"

  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    [ "$DRY_RUN" -eq 1 ] && printf '[MISSING] %s\n' "$path"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[WOULD REMOVE] %s\n' "$path"
  else
    rm -rf -- "$path"
  fi
}

backup_file() {
  local file="$1"

  [ -e "$file" ] || return 0

  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[WOULD BACKUP] %s\n' "$file"
    return 0
  fi

  mkdir -p "$BACKUP_DIR"
  cp -a --parents "$file" "$BACKUP_DIR/" 2>/dev/null || true
}

delete_rule_all() {
  local table="$1"
  local chain="$2"
  shift 2

  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[WOULD DELETE IPTABLES] table=%s chain=%s ' "$table" "$chain"
    printf '%q ' "$@"
    printf '\n'
    return 0
  fi

  while iptables -t "$table" -C "$chain" "$@" 2>/dev/null; do
    iptables -t "$table" -D "$chain" "$@" 2>/dev/null || break
  done
}

confirm_action() {
  local expected

  [ "$ASSUME_YES" -eq 1 ] && return 0

  case "$MODE" in
    --reinstall) expected="REINSTALL" ;;
    --full) expected="UNINSTALL" ;;
    *) return 0 ;;
  esac

  printf '\n'
  line
  printf '%s\n' "WARNING: destructive operation requested."
  printf '%s\n' "Repository will be preserved:"
  printf '  %s\n' "$PROJECT_ROOT"
  printf '%s\n' "OpenSSH will be preserved."
  line

  read -rp "Type ${expected} to continue: " answer

  if [ "$answer" != "$expected" ]; then
    printf 'Cancelled.\n'
    exit 0
  fi
}

collect_managed_ssh_users() {
  local store="/etc/hamada/ssh-accounts"
  local conf user

  [ -d "$store" ] || return 0

  for conf in "$store"/*.conf; do
    [ -f "$conf" ] || continue

    user="$(basename "$conf" .conf)"

    if [[ "$user" =~ ^[A-Za-z0-9_.-]{1,32}$ ]]; then
      printf '%s\n' "$user"
    fi
  done | sort -u
}

remove_managed_ssh_users() {
  local user

  while IFS= read -r user; do
    [ -n "$user" ] || continue

    if ! id "$user" >/dev/null 2>&1; then
      [ "$DRY_RUN" -eq 1 ] && printf '[MISSING USER] %s\n' "$user"
      continue
    fi

    if [ "$user" = "root" ]; then
      printf '[SKIP ROOT] %s\n' "$user"
      continue
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
      printf '[WOULD DELETE MANAGED SSH USER] %s\n' "$user"
    else
      pkill -u "$user" >/dev/null 2>&1 || true
      userdel "$user" >/dev/null 2>&1 || true
    fi
  done < <(collect_managed_ssh_users)
}

clean_l2tp_accounts() {
  local store="/etc/hamada/l2tp-accounts"

  if [ "$DRY_RUN" -eq 1 ]; then
    [ -d "$store" ] && printf '[WOULD CLEAN] HAMADA L2TP users from /etc/ppp/chap-secrets\n'
    return 0
  fi

  [ -d "$store" ] || return 0
  [ -f /etc/ppp/chap-secrets ] || return 0

  python3 - <<'PY'
from pathlib import Path

store = Path("/etc/hamada/l2tp-accounts")
chap = Path("/etc/ppp/chap-secrets")

if not store.is_dir() or not chap.exists():
    raise SystemExit(0)

users = {p.stem for p in store.glob("*.conf") if p.is_file()}

if not users:
    raise SystemExit(0)

out = []

for line in chap.read_text(errors="ignore").splitlines():
    stripped = line.strip()

    if not stripped or stripped.startswith("#"):
        out.append(line)
        continue

    first = stripped.split()[0].strip('"').strip("'")

    if first in users:
        continue

    out.append(line)

chap.write_text("\n".join(out) + "\n")
PY

  chmod 600 /etc/ppp/chap-secrets 2>/dev/null || true
}

restore_shared_configs() {
  local squid_backup

  section "RESTORE SHARED SERVICE CONFIGURATION"

  if [ -f /etc/haproxy/haproxy.cfg.hamada.bak ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      printf '[WOULD RESTORE] /etc/haproxy/haproxy.cfg.hamada.bak\n'
    else
      backup_file /etc/haproxy/haproxy.cfg
      cp -f \
        /etc/haproxy/haproxy.cfg.hamada.bak \
        /etc/haproxy/haproxy.cfg
      rm -f /etc/haproxy/haproxy.cfg.hamada.bak
    fi
  fi

  squid_backup="$(
    find /etc/squid -maxdepth 1 \
      -type f -name 'squid.conf.backup.*' \
      2>/dev/null | sort | head -n1
  )"

  if [ -n "$squid_backup" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      printf '[WOULD RESTORE SQUID] %s\n' "$squid_backup"
    else
      backup_file /etc/squid/squid.conf
      cp -f "$squid_backup" /etc/squid/squid.conf
      rm -f /etc/squid/squid.conf.backup.*
    fi
  fi

  remove_path /etc/nginx/conf.d/hamada-ssh.conf
  remove_path /etc/stunnel/hamada.conf
  remove_path /etc/systemd/system/squid.service.d/limits.conf

  if [ -d /etc/nginx/hamada-disabled ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      printf '[WOULD RESTORE] files from /etc/nginx/hamada-disabled\n'
    else
      shopt -s nullglob

      for item in /etc/nginx/hamada-disabled/*; do
        name="$(basename "$item")"

        if [ -L "$item" ]; then
          mv -f "$item" "/etc/nginx/sites-enabled/$name"
        elif [[ "$name" == *.conf ]]; then
          mv -f "$item" "/etc/nginx/conf.d/$name"
        else
          mv -f "$item" "/etc/nginx/sites-enabled/$name"
        fi
      done

      shopt -u nullglob
      rmdir /etc/nginx/hamada-disabled 2>/dev/null || true
    fi
  fi
}

remove_auto_menu() {
  if ! grep -qF '# HAMADA NET AUTO MENU' /root/.bashrc 2>/dev/null; then
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[WOULD REMOVE] HAMADA NET AUTO MENU from /root/.bashrc\n'
    return 0
  fi

  python3 - <<'PY'
from pathlib import Path

path = Path("/root/.bashrc")

if not path.exists():
    raise SystemExit(0)

lines = path.read_text(errors="ignore").splitlines()
out = []
i = 0

while i < len(lines):
    if lines[i].strip() == "# HAMADA NET AUTO MENU":
        i += 1

        while i < len(lines):
            if lines[i].strip() == "fi":
                i += 1
                break
            i += 1

        while out and out[-1] == "":
            out.pop()

        continue

    out.append(lines[i])
    i += 1

path.write_text("\n".join(out) + "\n")
PY
}

cleanup_firewall() {
  local iface

  iface="$(ip route show default 2>/dev/null | awk 'NR==1 {print $5}')"

  section "CLEAN FIREWALL RULES"

  if [ -n "$iface" ]; then
    delete_rule_all nat POSTROUTING \
      -s 10.8.0.0/24 -o "$iface" -j MASQUERADE

    delete_rule_all nat POSTROUTING \
      -s 10.9.0.0/24 -o "$iface" -j MASQUERADE

    delete_rule_all nat POSTROUTING \
      -s 10.20.0.0/24 -o "$iface" -j MASQUERADE

    delete_rule_all nat POSTROUTING \
      -s 10.21.0.0/24 -o "$iface" -j MASQUERADE

    delete_rule_all nat POSTROUTING \
      -s 10.30.0.0/24 -o "$iface" -j MASQUERADE

    delete_rule_all nat PREROUTING \
      -i "$iface" -p udp --dport 6000:19999 \
      -j DNAT --to-destination :5667
  fi

  for port in 500 4500 1701; do
    delete_rule_all filter INPUT \
      -p udp --dport "$port" -j ACCEPT
  done

  delete_rule_all filter INPUT \
    -p udp --dport 5667 -j ACCEPT

  delete_rule_all filter INPUT \
    -p udp --dport 6000:19999 -j ACCEPT

  delete_rule_all filter INPUT \
    -p udp --dport 53 -j ACCEPT

  for net in \
    10.20.0.0/24 \
    10.21.0.0/24 \
    10.30.0.0/24
  do
    delete_rule_all filter FORWARD \
      -s "$net" -j ACCEPT

    delete_rule_all filter FORWARD \
      -d "$net" -j ACCEPT

    if [ -n "$iface" ]; then
      delete_rule_all filter FORWARD \
        -s "$net" -o "$iface" -j ACCEPT

      delete_rule_all filter FORWARD \
        -d "$net" -m state \
        --state RELATED,ESTABLISHED -j ACCEPT
    fi
  done
}

remove_installed_commands() {
  local path name
  local -A seen=()

  section "REMOVE INSTALLED HAMADA COMMANDS"

  if [ -d "$PROJECT_ROOT/usr/bin" ]; then
    while IFS= read -r path; do
      name="$(basename "$path")"
      seen["$name"]=1

      if [ "$name" = "hamada-uninstall" ]; then
        continue
      fi

      remove_path "/usr/bin/$name"
    done < <(
      find "$PROJECT_ROOT/usr/bin" \
        -maxdepth 1 -type f -print 2>/dev/null | sort
    )
  fi

  for name in \
    menu \
    menu-settings \
    hamada-reset \
    hamada-doctor \
    hamada-update \
    hamada-speedtest \
    hamada-restore-defaults \
    hamada-public-ports \
    xrayctl \
    xray-menu
  do
    [ "${seen[$name]:-0}" = "1" ] && continue
    remove_path "/usr/bin/$name"
  done
}

show_preview() {
  section "HAMADA NET UNINSTALL PREVIEW"

  printf 'Mode        : %s\n' "$MODE"
  printf 'Version     : %s\n' "$VERSION"
  printf 'Repository  : %s\n' "$PROJECT_ROOT"
  printf 'OpenSSH     : PRESERVED\n'

  section "MANAGED SSH USERS"

  if ! collect_managed_ssh_users | grep -q .; then
    printf 'No managed SSH users detected.\n'
  else
    collect_managed_ssh_users |
      sed 's/^/  [MANAGED] /'
  fi

  section "SERVICES"

  for svc in \
    hamada-ssh-ws.service \
    hamada-dropbear-ws.service \
    hamada-openvpn-ws.service \
    openvpn-server@server-tcp-1194.service \
    openvpn-server@server-udp-2200.service \
    hamada-l2tp-firewall.service \
    xl2tpd.service \
    strongswan-starter.service \
    wg-quick@wg0.service \
    zivpn.service \
    hamada-zivpn-firewall.service \
    xray.service \
    hamada-xray-firewall.service \
    noobzvpns.service \
    hamada-psiphon.service \
    hamada-slowdns.service \
    hamada-slowdns-mux.service \
    hamada-net-firewall.service
  do
    if service_exists "$svc"; then
      printf '  [FOUND] %s (%s)\n' \
        "$svc" \
        "$(systemctl is-active "$svc" 2>/dev/null || true)"
    else
      printf '  [MISSING] %s\n' "$svc"
    fi
  done

  section "MAIN DATA"

  for path in \
    /etc/hamada \
    /etc/noobzvpns \
    /etc/zivpn \
    /etc/wireguard \
    /root/psiphon \
    /usr/local/hamada \
    /usr/local/lib/hamada \
    /usr/local/etc/xray \
    /var/log/xray \
    /var/log/hamada \
    /etc/openvpn/easy-rsa \
    /var/www/html/vpn-files \
    /var/www/html/wg-files \
    /var/www/html/payloads
  do
    if [ -e "$path" ]; then
      printf '  [FOUND] %s\n' "$path"
    else
      printf '  [MISSING] %s\n' "$path"
    fi
  done

  section "DRY RUN RESULT"

  printf '%s\n' 'No services were stopped.'
  printf '%s\n' 'No users were deleted.'
  printf '%s\n' 'No files were removed.'
  printf '%s\n' 'No firewall rules were changed.'
  printf '%s\n' 'Repository was not modified.'
}

perform_cleanup() {
  local ssh_server_port

  ssh_server_port="$(
    printf '%s\n' "${SSH_CONNECTION:-}" |
      awk '{print $4}'
  )"

  mkdir -p "$BACKUP_DIR"

  section "BACKUP IMPORTANT CONFIGURATION"

  for file in \
    /etc/haproxy/haproxy.cfg \
    /etc/squid/squid.conf \
    /etc/nginx/nginx.conf \
    /etc/ipsec.conf \
    /etc/ipsec.secrets \
    /etc/xl2tpd/xl2tpd.conf \
    /etc/ppp/options.xl2tpd \
    /etc/ppp/chap-secrets
  do
    backup_file "$file"
  done

  section "REMOVE MANAGED SSH ACCOUNTS"
  remove_managed_ssh_users
  clean_l2tp_accounts

  section "STOP HAMADA SERVICES"

  for svc in \
    hamada-slowdns.service \
    hamada-slowdns-mux.service \
    hamada-psiphon.service \
    noobzvpns.service \
    hamada-xray-firewall.service \
    xray.service \
    hamada-zivpn-firewall.service \
    zivpn.service \
    wg-quick@wg0.service \
    hamada-l2tp-firewall.service \
    xl2tpd.service \
    strongswan-starter.service \
    hamada-openvpn-ws.service \
    openvpn-server@server-tcp-1194.service \
    openvpn-server@server-udp-2200.service \
    hamada-dropbear-ws.service \
    hamada-ssh-ws.service \
    hamada-net-firewall.service
  do
    stop_disable_service "$svc"
  done

  if [ "$ssh_server_port" != "109" ] && \
     [ "$ssh_server_port" != "143" ]; then
    stop_disable_service dropbear.service
  else
    log "[PRESERVE CURRENT SESSION] Dropbear not stopped."
    systemctl disable dropbear.service >/dev/null 2>&1 || true
  fi

  for svc in \
    haproxy.service \
    nginx.service \
    squid.service \
    stunnel4.service
  do
    if service_exists "$svc"; then
      systemctl stop "$svc" >/dev/null 2>&1 || true
    fi
  done

  cleanup_firewall
  restore_shared_configs

  section "REMOVE SERVICE UNIT FILES"

  for path in \
    /etc/systemd/system/hamada-ssh-ws.service \
    /etc/systemd/system/hamada-dropbear-ws.service \
    /etc/systemd/system/hamada-openvpn-ws.service \
    /etc/systemd/system/hamada-l2tp-firewall.service \
    /etc/systemd/system/zivpn.service \
    /etc/systemd/system/hamada-zivpn-firewall.service \
    /etc/systemd/system/hamada-xray-firewall.service \
    /etc/systemd/system/noobzvpns.service \
    /etc/systemd/system/hamada-psiphon.service \
    /etc/systemd/system/hamada-slowdns.service \
    /etc/systemd/system/hamada-slowdns-mux.service \
    /etc/systemd/system/hamada-net-firewall.service
  do
    remove_path "$path"
  done

  section "REMOVE HAMADA DATA"

  for path in \
    /etc/hamada \
    /root/domain \
    /etc/v2ray/domain \
    /usr/local/hamada \
    /usr/local/lib/hamada \
    /usr/local/etc/xray \
    /var/log/xray \
    /var/log/hamada \
    /etc/noobzvpns \
    /etc/zivpn \
    /usr/local/bin/zivpn \
    /usr/local/sbin/hamada-zivpn-firewall \
    /etc/wireguard \
    /root/psiphon \
    /usr/local/bin/psiphond \
    /usr/local/bin/dnstt-server \
    /etc/openvpn/server/server-tcp-1194.conf \
    /etc/openvpn/server/server-udp-2200.conf \
    /etc/openvpn/server/ca.crt \
    /etc/openvpn/server/server.crt \
    /etc/openvpn/server/server.key \
    /etc/openvpn/server/dh.pem \
    /etc/openvpn/server/openvpn-tcp.log \
    /etc/openvpn/server/openvpn-udp.log \
    /etc/openvpn/easy-rsa \
    /var/www/html/vpn-files \
    /var/www/html/wg-files \
    /var/www/html/payloads \
    /var/www/html/hamada-ca.crt \
    /etc/sysctl.d/99-hamada-disable-ipv6.conf \
    /etc/sysctl.d/99-hamada-net-wireguard.conf \
    /etc/sysctl.d/99-hamada-net-l2tp.conf \
    /etc/sysctl.d/98-hamada-zivpn.conf \
    /etc/sysctl.d/99-hamada-slowdns-speed.conf \
    /etc/cron.d/hamada-net-l2tp-expire \
    /usr/local/sbin/hamada-l2tp-firewall \
    /etc/ipsec.d/private/hamada-net-ca-key.pem \
    /etc/ipsec.d/private/hamada-net-server-key.pem \
    /etc/ipsec.d/cacerts/hamada-net-ca-cert.pem \
    /etc/ipsec.d/certs/hamada-net-server-cert.pem \
    /etc/ppp/options.xl2tpd
  do
    remove_path "$path"
  done

  backup_file /etc/ipsec.conf
  backup_file /etc/xl2tpd/xl2tpd.conf

  remove_path /etc/ipsec.conf
  remove_path /etc/xl2tpd/xl2tpd.conf

  remove_installed_commands

  if [ "$MODE" = "--full" ]; then
    section "REMOVE ROOT AUTO MENU"
    remove_auto_menu
  fi

  if [ "$DRY_RUN" -eq 0 ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl reset-failed >/dev/null 2>&1 || true
  fi

  section "CLEANUP COMPLETE"

  printf 'Mode       : %s\n' "$MODE"
  printf 'Repository : PRESERVED (%s)\n' "$PROJECT_ROOT"
  printf 'OpenSSH    : PRESERVED\n'
  printf 'Backup     : %s\n' "$BACKUP_DIR"

  if [ "$MODE" = "--reinstall" ]; then
    printf '%s\n' 'Server is ready for HAMADA NET reinstallation.'
  else
    printf '%s\n' 'HAMADA NET full uninstall completed.'
    printf '%s\n' 'A reboot is recommended.'
  fi
}

clear
line
printf '%s\n' '               HAMADA NET UNINSTALL TOOL'
printf 'Version: %s\n' "$VERSION"
line

if [ "$MODE" = "--dry-run" ]; then
  show_preview
  exit 0
fi

confirm_action
perform_cleanup
