#!/usr/bin/env bash
set -u
RUNTIME_ROOT="${HAMADA_HOME:-/opt/hamada}"
CURRENT="$RUNTIME_ROOT/current"
LEGACY="$RUNTIME_ROOT/legacy/renew-ssh"
PYTHON_BIN="${HAMADA_PYTHON:-/usr/bin/python3}"
if [ ! -x "$PYTHON_BIN" ] || [ ! -d "$CURRENT/hamada" ]; then
  [ -x "$LEGACY" ] || { echo "ERROR: HAMADA SSH Core unavailable and Legacy fallback missing." >&2; exit 20; }
  exec "$LEGACY" "$@"
fi
if ! PYTHONPATH="$CURRENT" "$PYTHON_BIN" -m hamada.runtime.cli runtime-check --root "$RUNTIME_ROOT" >/dev/null 2>&1; then
  [ -x "$LEGACY" ] || { echo "ERROR: HAMADA SSH Core failed preflight and Legacy fallback is missing." >&2; exit 20; }
  exec "$LEGACY" "$@"
fi
# Mutation boundary: never auto-fallback after invoking the Core renew operation.
exec env PYTHONPATH="$CURRENT" "$PYTHON_BIN" -m hamada.runtime.cli ssh-renew --root "$RUNTIME_ROOT" "$@"
