#!/usr/bin/env bash
set -euo pipefail

BASE="/etc/hamada/wg-accounts"
WEB="/var/www/html/wg-files"
DOMAIN="$(cat /etc/hamada/domain 2>/dev/null || hostname -I | awk '{print $1}')"
WG_DOMAIN="$(cat /etc/hamada/wireguard-domain 2>/dev/null || printf '%s' "$DOMAIN")"
SERVER_PUBLIC="$(cat /etc/hamada/wg-server-public.key 2>/dev/null || true)"
mkdir -p "$BASE" "$WEB"

mapfile -t files < <(find "$BASE" -maxdepth 1 -type f -name '*.conf' | sort)

clear
echo "============================================"
echo "        HAMADA NET WIREGUARD ACCOUNTS"
echo "============================================"

if [ "${#files[@]}" -eq 0 ]; then
  echo "No WireGuard accounts found."
  echo "============================================"
  read -rp "Press Enter to continue..."
  exit 0
fi

n=1
for f in "${files[@]}"; do
  username=""; expire=""; address=""
  . "$f" || true
  exp_h="$(date -d "$expire" "+%b %d, %Y" 2>/dev/null || echo "$expire")"
  printf "[%02d] %-18s | %-12s | %s\n" "$n" "$username" "$exp_h" "$address"
  n=$((n+1))
done

echo "============================================"
read -rp "Select account number to show, or 0 back: " choice
[[ "$choice" =~ ^[0-9]+$ ]] || exit 0
[ "$choice" -eq 0 ] && exit 0
idx=$((choice-1))
[ "$idx" -ge 0 ] && [ "$idx" -lt "${#files[@]}" ] || exit 0

username=""; private_key=""; public_key=""; address=""; expire=""; domain=""; bug_host=""; endpoint_host=""
. "${files[$idx]}" || true
endpoint_host="${endpoint_host:-${domain:-$WG_DOMAIN}}"
bug_host="${bug_host:-}"
expire_human="$(date -d "$expire" "+%b %d, %Y" 2>/dev/null || echo "$expire")"

clear
echo "============================================"
echo "          HAMADA NET WIREGUARD ACCOUNT"
echo "============================================"
echo "Username       : $username"
echo "Expired On     : $expire_human"
echo "Host           : $DOMAIN"
echo "SNI/Bug Host   : ${bug_host:-none}"
echo "Endpoint       : $endpoint_host:51820"
echo "Client Address : $address/32"
echo "Config Link    : http://$DOMAIN/wg-files/$username.conf"
echo "QR Link        : http://$DOMAIN/wg-files/$username.png"
echo "============================================"
echo "Client Config:"
cat "$WEB/$username.conf" 2>/dev/null || echo "Config file not found."
echo "============================================"
echo "Router / MikroTik Values:"
echo "Interface PrivateKey : $private_key"
echo "Address              : $address/32"
echo "Peer PublicKey        : $SERVER_PUBLIC"
echo "Endpoint             : $endpoint_host:51820"
echo "AllowedIPs           : 0.0.0.0/0"
echo "PersistentKeepalive  : 25"
echo "============================================"
read -rp "Press Enter to continue..."
