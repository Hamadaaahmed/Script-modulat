#!/usr/bin/env bash
set -euo pipefail

BASE="/etc/hamada/l2tp-accounts"
mkdir -p "$BASE"

mapfile -t files < <(find "$BASE" -maxdepth 1 -type f -name '*.conf' | sort)

clear
echo "============================================"
echo "        HAMADA NET RENEW L2TP ACCOUNT"
echo "============================================"

if [ "${#files[@]}" -eq 0 ]; then
  echo "No L2TP accounts found."
  echo "============================================"
  read -rp "Press Enter to continue..."
  exit 0
fi

n=1
for f in "${files[@]}"; do
  username=""; expire=""
  . "$f" || true
  exp_h="$(date -d "$expire" "+%b %d, %Y" 2>/dev/null || echo "$expire")"
  printf "[%02d] %-20s | %s\n" "$n" "$username" "$exp_h"
  n=$((n+1))
done
echo "============================================"
read -rp "Select account number to renew: " choice
[[ "$choice" =~ ^[0-9]+$ ]] || exit 0
idx=$((choice-1))
[ "$idx" -ge 0 ] && [ "$idx" -lt "${#files[@]}" ] || exit 0

read -rp "Add days: " days
[[ "$days" =~ ^[0-9]+$ ]] || exit 0

username=""; password=""; expire=""; domain=""
. "${files[$idx]}" || true

base_date="$expire"
if [[ "$base_date" < "$(date +%Y-%m-%d)" ]]; then
  base_date="$(date +%Y-%m-%d)"
fi
new_expire="$(date -d "$base_date +${days} days" +%Y-%m-%d)"

cat > "${files[$idx]}" <<EOFC
username="$username"
password="$password"
expire="$new_expire"
domain="${domain:-$(cat /etc/hamada/domain 2>/dev/null || hostname -I | awk '{print $1}')}"
EOFC

hn-l2tp-sync

echo "Renewed: $username"
echo "New Expire: $(date -d "$new_expire" "+%b %d, %Y")"
read -rp "Press Enter to continue..."
