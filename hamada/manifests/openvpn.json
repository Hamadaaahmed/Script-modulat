{
  "schema_version": 1,
  "id": "openvpn",
  "name": "OpenVPN",
  "version": "phase3a-reference-1",
  "description": "OpenVPN TCP, UDP and WebSocket runtime with Phase 3A read-only Core inspection.",
  "dependencies": {
    "modules": [
      "edge"
    ],
    "optional_modules": [
      "ssh"
    ],
    "infrastructure": []
  },
  "conflicts": {
    "modules": [],
    "notes": []
  },
  "requirements": {
    "packages": [
      "openvpn"
    ],
    "binaries": [
      "openvpn"
    ],
    "certificate": false,
    "edge": true
  },
  "paths": {
    "config": [
      "/etc/openvpn/server/server-tcp-1194.conf",
      "/etc/openvpn/server/server-udp-2200.conf"
    ],
    "data": [
      "/var/www/html/vpn-files"
    ],
    "legacy": []
  },
  "services": [
    {
      "name": "openvpn-server@server-tcp-1194.service",
      "ownership": "legacy"
    },
    {
      "name": "openvpn-server@server-udp-2200.service",
      "ownership": "legacy"
    },
    {
      "name": "hamada-openvpn-ws.service",
      "ownership": "legacy"
    }
  ],
  "ports": {
    "public_tcp": [
      {
        "port": 1194,
        "purpose": "OpenVPN TCP"
      }
    ],
    "public_udp": [
      {
        "port": 2200,
        "purpose": "OpenVPN UDP"
      }
    ],
    "internal_tcp": [
      {
        "port": 10082,
        "purpose": "OpenVPN WebSocket bridge"
      }
    ],
    "internal_udp": []
  },
  "firewall": {
    "ownership": "legacy",
    "requirements": [
      "NAT/forwarding rules are legacy-owned"
    ]
  },
  "edge": {
    "ownership": "none",
    "routes": [],
    "backends": []
  },
  "accounts": {
    "supported": true,
    "backend": "linux-pam-external",
    "capabilities": [
      "authenticate-existing-linux-account"
    ]
  },
  "healthchecks": [
    "openvpn-binary",
    "server-configs",
    "pki-files",
    "pam-plugin",
    "systemd-services",
    "client-profiles",
    "tcp-1194-listener",
    "udp-2200-listener",
    "websocket-10082-listener"
  ],
  "lifecycle": [
    "preflight",
    "validate",
    "verify",
    "reconcile"
  ],
  "migration": {
    "status": "reference",
    "phase": "3A",
    "core_ownership": [
      "read-only OpenVPN configuration parsing",
      "read-only runtime inspection",
      "read-only health reporting",
      "observed runtime contract"
    ],
    "legacy_ownership": [
      "OpenVPN installation",
      "PKI generation",
      "server configuration writes",
      "systemd service lifecycle",
      "WebSocket bridge configuration",
      "client profile generation",
      "NAT and forwarding rules",
      "Nginx and HAProxy routing"
    ],
    "external_ownership": [
      "Linux account lifecycle",
      "PAM account backend"
    ]
  }
}
