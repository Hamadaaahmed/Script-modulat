{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hamada.net/schemas/module.schema.json",
  "title": "HAMADA NET Module Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "dependencies",
    "conflicts",
    "requirements",
    "paths",
    "services",
    "ports",
    "firewall",
    "edge",
    "accounts",
    "healthchecks",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "optional_modules",
        "infrastructure"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "optional_modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "infrastructure": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "conflicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "notes"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": [
        "packages",
        "binaries",
        "certificate",
        "edge"
      ],
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "certificate": {
          "type": "boolean"
        },
        "edge": {
          "type": "boolean"
        }
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "config",
        "data",
        "legacy"
      ],
      "properties": {
        "config": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "legacy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "ownership"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ownership": {
            "enum": [
              "legacy",
              "future"
            ]
          }
        }
      }
    },
    "ports": {
      "type": "object",
      "required": [
        "public_tcp",
        "public_udp",
        "internal_tcp",
        "internal_udp"
      ],
      "properties": {
        "public_tcp": {
          "$ref": "#/$defs/ports"
        },
        "public_udp": {
          "$ref": "#/$defs/ports"
        },
        "internal_tcp": {
          "$ref": "#/$defs/ports"
        },
        "internal_udp": {
          "$ref": "#/$defs/ports"
        }
      }
    },
    "firewall": {
      "type": "object",
      "required": [
        "ownership",
        "requirements"
      ],
      "properties": {
        "ownership": {
          "enum": [
            "legacy",
            "central-future",
            "none"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "ownership",
        "routes",
        "backends"
      ],
      "properties": {
        "ownership": {
          "enum": [
            "legacy",
            "central-future",
            "none"
          ]
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "backends": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "accounts": {
      "type": "object",
      "required": [
        "supported",
        "backend",
        "capabilities"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "account_create",
              "account_delete",
              "account_renew",
              "account_expire",
              "account_list",
              "account_status",
              "account_reconcile"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "healthchecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "enum": [
              "file_exists",
              "binary_exists",
              "config_validity",
              "systemd_unit_exists",
              "service_state",
              "port_state",
              "certificate_state",
              "dependency_state"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "enum": [
          "preflight",
          "install",
          "configure",
          "validate",
          "enable",
          "start",
          "verify",
          "reconcile",
          "migrate",
          "uninstall"
        ]
      },
      "uniqueItems": true
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "migrated_ownership",
        "legacy_ownership",
        "compatibility"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "reference-ready",
            "partial",
            "migrated"
          ]
        },
        "migrated_ownership": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "legacy_ownership": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compatibility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "ports": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "port",
              "purpose"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "purpose": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "start",
              "end",
              "purpose"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "purpose": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
